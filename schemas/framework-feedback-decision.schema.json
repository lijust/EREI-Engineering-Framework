{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/framework-feedback-decision.schema.json",
  "title": "EREI Framework Feedback Central Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "decided_at", "decision_revision", "source",
    "cluster_id", "review_state", "promotion_state", "decision_note", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^EFD-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decision_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "feedback_id"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "feedback_id": {"type": "string", "pattern": "^EFF-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"}
      }
    },
    "cluster_id": {"type": "string", "pattern": "^FCL-[A-Z0-9-]+$"},
    "review_state": {"enum": ["triaged", "project_local", "needs_evidence", "clustered", "candidate", "promoted", "rejected"]},
    "promotion_state": {"enum": ["not_promoted", "candidate", "promoted", "rejected"]},
    "candidate_ref": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "promotion_ref": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "decision_note": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"promotion_state": {"const": "candidate"}}},
      "then": {"required": ["candidate_ref"]}
    },
    {
      "if": {"properties": {"promotion_state": {"const": "promoted"}}},
      "then": {"required": ["candidate_ref", "promotion_ref"]}
    }
  ]
}
