{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/learning-review.schema.json",
  "title": "EREI Learning Review Record V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "closed_at", "epoch_id", "reviewed_occurrence_ids",
    "event_digest", "trigger", "metrics", "findings", "decision", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "review_id": {"type": "string", "pattern": "^ELR-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"},
    "closed_at": {"type": "string", "format": "date-time"},
    "epoch_id": {"type": "string", "pattern": "^EPOCH-[0-9]{3,}$"},
    "reviewed_occurrence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "event_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["INSUFFICIENT_EVIDENCE", "LEARNING_HEALTHY", "LEARNING_WATCH", "REVIEW_RECOMMENDED", "REVIEW_DUE", "IMMEDIATE_REVIEW"]},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "metrics": {"type": "object"},
    "findings": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
