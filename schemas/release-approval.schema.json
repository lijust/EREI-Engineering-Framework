{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/release-approval.schema.json",
  "title": "EREI Framework Release Approval V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "target_framework_ref",
    "target_tree",
    "decision",
    "recorded_at",
    "reviewer",
    "review_provenance",
    "evidence",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "approval_id": {
      "type": "string",
      "pattern": "^EAPP-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"
    },
    "approval_type": {
      "enum": [
        "architecture",
        "security"
      ]
    },
    "target_framework_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "target_tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github_user",
            "framework_role",
            "external_reviewer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "review_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "reviewer_login",
        "review_type",
        "purpose"
      ],
      "properties": {
        "provider": {
          "const": "github_codex_review"
        },
        "reviewer_login": {
          "const": "chatgpt-codex-connector[bot]"
        },
        "review_type": {
          "enum": [
            "code_review",
            "security_review"
          ]
        },
        "purpose": {
          "enum": [
            "architecture_approval",
            "security_approval"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "architecture_approval"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "review_type": {
                "const": "code_review"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "security_approval"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "review_type": {
                "const": "security_review"
              }
            }
          }
        }
      ]
    }
  }
}
