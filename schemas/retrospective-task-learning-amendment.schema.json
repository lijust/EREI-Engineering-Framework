{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/retrospective-task-learning-amendment.schema.json",
  "title": "EREI Retrospective Task Learning Amendment V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "amendment_id", "recorded_at", "occurrence_id", "reason", "changes", "producer"],
  "properties": {
    "schema_version": {"const": 1},
    "amendment_id": {"type": "string", "pattern": "^EAMD-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "occurrence_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "changes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_quality": {"enum": ["confirmed", "reconstructed", "inferred"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ESRC-[A-Z0-9][A-Z0-9._-]{2,127}$"}},
        "outcome_class": {"enum": ["verified_success", "success_with_deferred", "blocked", "failed", "canceled", "unknown"]},
        "signals": {"type": "array"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  }
}
