{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/retrospective-source-provenance.schema.json",
  "title": "EREI Retrospective Source Provenance V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_id", "kind", "repository", "revision", "locator",
    "event_time", "event_time_meaning", "reconstruction_time"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^ESRC-[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "kind": {"enum": ["github_pr", "github_commit", "ci_run", "artifact", "runtime_episode", "other"]},
    "repository": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "locator": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ci_run_id": {"type": "integer", "minimum": 1},
    "ci_attempt": {"type": "integer", "minimum": 1},
    "event_time": {"type": ["string", "null"], "format": "date-time"},
    "event_time_meaning": {"enum": ["exact_event", "task_completion", "observation", "unknown"]},
    "reconstruction_time": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "minLength": 1}
  }
}
