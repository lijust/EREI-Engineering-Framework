{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/learning-review-defer.schema.json",
  "title": "EREI Learning Review Defer V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","defer_id","epoch_id","recorded_at","expires_at",
    "baseline_material_tasks","max_additional_material_tasks","reason",
    "reviewed_by_role","evidence","fingerprint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "defer_id": {"type": "string", "pattern": "^ELD-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{8}$"},
    "epoch_id": {"type": "string", "pattern": "^EPOCH-[0-9]{3,}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "baseline_material_tasks": {"type": "integer", "minimum": 0},
    "max_additional_material_tasks": {"type": "integer", "minimum": 0, "maximum": 10},
    "reason": {"type": "string", "minLength": 20},
    "reviewed_by_role": {"type": "string", "minLength": 3},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
