{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/learning-state.schema.json",
  "title": "EREI Project Learning State V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "epoch_id", "updated_at", "last_review_id", "last_review_at",
    "event_cutoff", "total_events", "metrics_since_last_review", "trigger"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "epoch_id": {"type": "string", "pattern": "^EPOCH-[0-9]{3,}$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "last_review_id": {"type": ["string", "null"]},
    "last_review_at": {"type": ["string", "null"]},
    "event_cutoff": {"type": "integer", "minimum": 0},
    "total_events": {"type": "integer", "minimum": 0},
    "metrics_since_last_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks", "material_tasks", "verified_successes", "blocked_tasks", "failed_tasks",
        "rework_tasks", "total_rework_cycles", "verification_failure_tasks",
        "verification_failures", "verification_escapes", "framework_feedback_tasks",
        "manual_workarounds", "context_gaps", "unexpected_scope_growth_tasks",
        "security_or_data_critical_events", "max_feedback_fingerprint_occurrences",
        "rework_rate", "verification_failure_rate"
      ],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0},
        "material_tasks": {"type": "integer", "minimum": 0},
        "verified_successes": {"type": "integer", "minimum": 0},
        "blocked_tasks": {"type": "integer", "minimum": 0},
        "failed_tasks": {"type": "integer", "minimum": 0},
        "rework_tasks": {"type": "integer", "minimum": 0},
        "total_rework_cycles": {"type": "integer", "minimum": 0},
        "verification_failure_tasks": {"type": "integer", "minimum": 0},
        "verification_failures": {"type": "integer", "minimum": 0},
        "verification_escapes": {"type": "integer", "minimum": 0},
        "framework_feedback_tasks": {"type": "integer", "minimum": 0},
        "manual_workarounds": {"type": "integer", "minimum": 0},
        "context_gaps": {"type": "integer", "minimum": 0},
        "unexpected_scope_growth_tasks": {"type": "integer", "minimum": 0},
        "security_or_data_critical_events": {"type": "integer", "minimum": 0},
        "max_feedback_fingerprint_occurrences": {"type": "integer", "minimum": 0},
        "rework_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "verification_failure_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["LEARNING_HEALTHY", "LEARNING_WATCH", "REVIEW_RECOMMENDED", "REVIEW_DUE", "IMMEDIATE_REVIEW"]},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
