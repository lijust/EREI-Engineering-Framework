{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/learning-state.schema.json",
  "title": "EREI Project Learning State V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "epoch_id", "updated_at", "last_review_id", "last_review_at",
    "legacy_event_cutoff", "reviewed_occurrence_count", "total_events",
    "metrics_since_last_review", "trigger"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "epoch_id": {"type": "string", "pattern": "^EPOCH-[0-9]{3,}$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "last_review_id": {"type": ["string", "null"]},
    "last_review_at": {"type": ["string", "null"]},
    "legacy_event_cutoff": {"type": "integer", "minimum": 0},
    "reviewed_occurrence_count": {"type": "integer", "minimum": 0},
    "total_events": {"type": "integer", "minimum": 0},
    "metrics_since_last_review": {
      "type": "object",
      "required": [
        "tasks", "material_tasks", "verified_successes", "blocked_tasks", "failed_tasks",
        "rework_assessed_material_tasks", "verification_assessed_material_tasks",
        "unassessed_signal_values", "rework_tasks", "total_rework_cycles",
        "verification_failure_tasks", "verification_failures", "verification_escapes",
        "framework_feedback_tasks", "manual_workarounds", "context_gaps",
        "unexpected_scope_growth_tasks", "security_or_data_critical_events",
        "max_feedback_fingerprint_occurrences", "rework_rate", "verification_failure_rate",
        "failure_stages", "failure_subjects", "cohorts"
      ],
      "properties": {
        "tasks": {"type": "integer", "minimum": 0},
        "material_tasks": {"type": "integer", "minimum": 0},
        "verified_successes": {"type": "integer", "minimum": 0},
        "blocked_tasks": {"type": "integer", "minimum": 0},
        "failed_tasks": {"type": "integer", "minimum": 0},
        "rework_assessed_material_tasks": {"type": "integer", "minimum": 0},
        "verification_assessed_material_tasks": {"type": "integer", "minimum": 0},
        "unassessed_signal_values": {"type": "integer", "minimum": 0},
        "rework_tasks": {"type": "integer", "minimum": 0},
        "total_rework_cycles": {"type": "integer", "minimum": 0},
        "verification_failure_tasks": {"type": "integer", "minimum": 0},
        "verification_failures": {"type": "integer", "minimum": 0},
        "verification_escapes": {"type": "integer", "minimum": 0},
        "framework_feedback_tasks": {"type": "integer", "minimum": 0},
        "manual_workarounds": {"type": "integer", "minimum": 0},
        "context_gaps": {"type": "integer", "minimum": 0},
        "unexpected_scope_growth_tasks": {"type": "integer", "minimum": 0},
        "security_or_data_critical_events": {"type": "integer", "minimum": 0},
        "max_feedback_fingerprint_occurrences": {"type": "integer", "minimum": 0},
        "rework_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "verification_failure_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "failure_stages": {"type": "object"},
        "failure_subjects": {"type": "object"},
        "cohorts": {"type": "object"}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["INSUFFICIENT_EVIDENCE", "LEARNING_HEALTHY", "LEARNING_WATCH", "REVIEW_RECOMMENDED", "REVIEW_DUE", "IMMEDIATE_REVIEW"]},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
