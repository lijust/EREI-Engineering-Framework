{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/release-scope.schema.json",
  "title": "EREI VNext Release Scope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "status",
    "release_family",
    "target_baseline",
    "capabilities",
    "release_control_dependencies",
    "required_eval_suites",
    "excluded_candidate_capabilities",
    "post_promotion_gates",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "const": "approved"
    },
    "release_family": {
      "type": "string",
      "minLength": 1
    },
    "target_baseline": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "release_control_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_eval_suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "suite_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^evals/cases/[A-Za-z0-9._-]+\\.eval\\.json$"
          },
          "suite_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excluded_candidate_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "post_promotion_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    }
  }
}
