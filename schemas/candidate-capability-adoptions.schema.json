{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei-framework.local/schemas/candidate-capability-adoptions.schema.json",
  "title": "EREI Project Candidate Capability Adoptions V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework_ref", "adoptions"],
  "properties": {
    "schema_version": {"const": 1},
    "framework_ref": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "adoptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "version", "adopted_at", "expires_at", "approved_by_role", "evidence"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "adopted_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "approved_by_role": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
