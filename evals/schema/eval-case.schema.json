{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erei.local/schemas/eval-case.schema.json",
  "title": "EREI Eval Suite V1",
  "type": "object",
  "required": ["schema_version", "suite_id", "artifact", "cases"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "assurance_scope": {"enum": ["behavioral_runtime", "harness_only"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expectations"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"type": "object"},
          "context": {"type": "object"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "expectations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type", "values"],
                  "properties": {
                    "type": {"enum": ["output_contains_all", "output_contains_none"]},
                    "values": {"type": "array", "items": {"type": "string"}}
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "pattern"],
                  "properties": {
                    "type": {"const": "output_regex"},
                    "pattern": {"type": "string", "minLength": 1}
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "key", "value"],
                  "properties": {
                    "type": {"const": "metadata_equals"},
                    "key": {"type": "string", "minLength": 1},
                    "value": {}
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "tool"],
                  "properties": {
                    "type": {"enum": ["trace_tool_called", "trace_tool_not_called"]},
                    "tool": {"type": "string", "minLength": 1}
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "value"],
                  "properties": {
                    "type": {"const": "max_trace_steps"},
                    "value": {"type": "integer", "minimum": 0}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
